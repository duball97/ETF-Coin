# Shared / treasury
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Prefer a paid RPC (Helius, Triton, etc.) for holder snapshots
# HELIUS_API_KEY=

# Creator / operator wallet (base58 secret key). Never commit the real value.
CREATOR_SECRET_KEY=

# $ETF mint (set after launch)
ETF_MINT=

# Optional: override path to basket config (default: treasury/basket.json)
# BASKET_PATH=./treasury/basket.json

# Leave this much SOL in the wallet for rent + fees (lamports)
GAS_RESERVE_LAMPORTS=50000000

# Skip cycles below this claimable amount (lamports)
MIN_CLAIM_LAMPORTS=10000000

# Jupiter Ultra API key (optional but recommended)
# JUPITER_API_KEY=

# Dry-run by default. Set to false to broadcast.
DRY_RUN=true

# Airdrop batching
AIRDROP_BATCH_SIZE=8
MIN_HOLDER_BALANCE=1

# Exclude addresses from airdrop (comma-separated pubkeys)
# EXCLUDE_HOLDERS=
